<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp">

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_language" />

        <RadioGroup
            android:id="@+id/language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/langEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_lang_en" />

            <RadioButton
                android:id="@+id/langHi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/settings_lang_hi" />
        </RadioGroup>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_volume" />

        <SeekBar
            android:id="@+id/volume"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="10" />

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_sensitivity" />

        <RadioGroup
            android:id="@+id/sensitivity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/sensLow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_sens_low" />

            <RadioButton
                android:id="@+id/sensNormal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_sens_normal" />

            <RadioButton
                android:id="@+id/sensHigh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_sens_high" />
        </RadioGroup>

        <TextView
            style="@style/SettingsHeader"
            android:text="@string/settings_fusion" />

        <RadioGroup
            android:id="@+id/fusion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/fusionTiered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_fusion_tiered" />

            <RadioButton
                android:id="@+id/fusionOr"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/settings_fusion_or" />
        </RadioGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/voice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_voice" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/vibration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_vibration" />

        <Button
            android:id="@+id/testAlert"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/settings_test" />

        <Button
            android:id="@+id/shareLog"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_share_log" />

        <Button
            android:id="@+id/demo"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_demo_start" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="12dp"
            android:text="@string/disclaimer"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
